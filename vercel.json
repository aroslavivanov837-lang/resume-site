{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "US"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "lang"
        }
      ],
      "destination": "/?lang=en",
      "permanent": false
    }
  ]
}
